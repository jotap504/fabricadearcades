NODE_ENV=production
PORT=3001

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_POSTGRES_PASSWORD=replace-with-long-random-password

LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat-v3.1
LLM_FALLBACK_MODEL=deepseek/deepseek-chat-v3.1
LLM_TEMPERATURE=0.1
OPENROUTER_SITE_URL=https://fabricadearcades.com
OPENROUTER_APP_NAME="Fabrica de Arcades WhatsApp Bot"

EMBEDDING_PROVIDER=openrouter
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Opcional: si queda vacío y EMBEDDING_PROVIDER=openrouter, se usa LLM_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small

WEBHOOK_SECRET=
ADMIN_PHONE=
LOG_LEVEL=info
DEBOUNCE_MS=2500

EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
EVOLUTION_PORT=18080
BOT_WORKER_PORT=13001

# Variables Evolution v2: revisar contra docs de la versión elegida antes de activar.
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:${EVOLUTION_POSTGRES_PASSWORD}@evolution-postgres:5432/evolution
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/0
